NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-local-password
DB_NAME=mi_finanzas
DB_SSL_CA=./tidb-ca.pem

# Comma-separated frontend origins. Required for production.
CORS_ORIGINS=http://localhost:4200

# Generate a long random value before deploying.
SESSION_SECRET=replace-with-long-random-secret